# Data Source Configuration
# No API keys needed - all news sources are public and free!

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (SQLite). On Render, /tmp is used automatically instead of ./data
DB_PATH=./data/news.db

# CORS: comma-separated list of allowed origins. If unset, production defaults
# to the app's own domain and development also allows localhost.
CORS_ALLOWED_ORIGINS=https://marketfeed.onrender.com,http://localhost:3000

# ==================== NEWS AGGREGATION / SYNC ====================
# Number of companies fetched concurrently per aggregation batch
AGGREGATION_BATCH_SIZE=2

# How many days back Google News RSS should search per company (default: 3)
GOOGLE_NEWS_WINDOW_DAYS=3

# Target number of articles to try to collect per company per sync
TARGET_ARTICLE_COUNT=8

# Per-source fetch timeout in milliseconds
SOURCE_TIMEOUT_MS=12000

# Hard cap on rows returned when a request asks for pageSize=all
MAX_ALL_PAGE_SIZE=1000

# Whether background/periodic syncing runs automatically on server start
AUTO_SYNC_ENABLED=true
# Interval between periodic syncs, in milliseconds (default: 6 hours)
AUTO_SYNC_INTERVAL_MS=21600000
# Whether to run an initial sync shortly after server startup if the DB is nearly empty
INITIAL_SYNC_ENABLED=false
# Minimum news count below which the initial sync is triggered
INITIAL_SYNC_MIN_NEWS_COUNT=10

# ==================== DATA CLEANUP ====================
# Delay before the first cleanup pass after startup, in milliseconds
CLEANUP_DELAY_MS=30000
# Interval between recurring cleanup passes, in milliseconds (default: 24 hours)
CLEANUP_INTERVAL_MS=86400000

# ==================== EMAIL DIGEST ====================
# Whether the periodic digest-sending job runs at all
AUTO_DIGEST_ENABLED=true
# How often to check for due digests, in milliseconds (default: 1 hour)
DIGEST_CHECK_INTERVAL_MS=3600000

# SMTP credentials for sending digest emails. If any of these are unset,
# digests are collected but NOT sent (a one-time log message is printed).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public URLs used inside outgoing digest emails
APP_URL=http://localhost:3000
UNSUBSCRIBE_URL=http://localhost:3000/api/unsubscribe

# ==================== TEXT-TO-SPEECH (PODCAST / REPORT AUDIO) ====================
# Enable Edge TTS for podcast and report audio generation
ENABLE_EDGE_TTS=false

# Web Scraping User Agent (for respectful crawling)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36
